# Copy this file to .env (gitignored) and change the values there.
# Every script in cli/build-scripts and the auth server read .env, and fall back to the DEFAULT_ values
# for keys that are missing. Keys added to this template are appended to .env automatically by the scripts.
#
# All runtime state of a project lives below /var/lib/<project> by default:
#   DATA_PATH     persistent data (e.g. the user database)
#   RUNTIME_PATH  pid files, logs, sessions, anything that may be deleted while the project is stopped
#   SECRETS_PATH  encryption keys and credentials (mode 700)
#   TEMP_PATH     scratch files

# Homepie (landing page + auth server)
DEFAULT_HOMEPIE_CLI_PATH=/usr/local/bin/hp
DEFAULT_HOMEPIE_DATA_PATH=/var/lib/homepie
DEFAULT_HOMEPIE_RUNTIME_PATH=/var/lib/homepie/run
DEFAULT_HOMEPIE_SECRETS_PATH=/var/lib/homepie/secrets
DEFAULT_HOMEPIE_SOURCE_PATH=/usr/local/src/homepie
DEFAULT_HOMEPIE_TEMP_PATH=/var/lib/homepie/tmp
DEFAULT_HOMEPIE_VENV_PATH=/usr/local/src/homepie/venv

# Homepie auth server
DEFAULT_HOMEPIE_AUTH_COOKIE_DOMAIN=.homepie.net
DEFAULT_HOMEPIE_AUTH_HOST=127.0.0.1
DEFAULT_HOMEPIE_AUTH_MAX_FAILED_ATTEMPTS=3
DEFAULT_HOMEPIE_AUTH_PORT=8888
DEFAULT_HOMEPIE_AUTH_SESSION_IDLE_HOURS=72
DEFAULT_HOMEPIE_AUTH_SESSION_MAX_DAYS=30
DEFAULT_HOMEPIE_CLIENT_DEV_PORT=5173
DEFAULT_HOMEPIE_DOMAIN=homepie.net

# Lockkliye
DEFAULT_LOCKKLIYE_DATA_PATH=/var/lib/lockkliye
DEFAULT_LOCKKLIYE_RUNTIME_PATH=/var/lib/lockkliye/run
DEFAULT_LOCKKLIYE_SECRETS_PATH=/var/lib/lockkliye/secrets
DEFAULT_LOCKKLIYE_SOURCE_PATH=/usr/local/src/lockkliye
DEFAULT_LOCKKLIYE_TEMP_PATH=/var/lib/lockkliye/tmp

# Teatype
DEFAULT_TEATYPE_DATA_PATH=/var/lib/teatype
DEFAULT_TEATYPE_PYTHON_SOURCE_PATH=/usr/local/src/teatype/python
DEFAULT_TEATYPE_RUNTIME_PATH=/var/lib/teatype/run
DEFAULT_TEATYPE_SECRETS_PATH=/var/lib/teatype/secrets
DEFAULT_TEATYPE_SOURCE_PATH=/usr/local/src/teatype
DEFAULT_TEATYPE_TEMP_PATH=/var/lib/teatype/tmp
DEFAULT_TEATYPE_TYPESCRIPT_SOURCE_PATH=/usr/local/src/teatype/typescript

DEFAULT_USING_WSL=false

# Homepie (landing page + auth server)
HOMEPIE_CLI_PATH=/usr/local/bin/hp
HOMEPIE_DATA_PATH=/var/lib/homepie
HOMEPIE_RUNTIME_PATH=/var/lib/homepie/run
HOMEPIE_SECRETS_PATH=/var/lib/homepie/secrets
HOMEPIE_SOURCE_PATH=/usr/local/src/homepie
HOMEPIE_TEMP_PATH=/var/lib/homepie/tmp
HOMEPIE_VENV_PATH=/usr/local/src/homepie/venv

# Homepie auth server
HOMEPIE_AUTH_COOKIE_DOMAIN=.homepie.net
HOMEPIE_AUTH_HOST=127.0.0.1
# Consecutive failed logins until the user is DELETED (the lockscreen shows 3 hearts)
HOMEPIE_AUTH_MAX_FAILED_ATTEMPTS=3
HOMEPIE_AUTH_PORT=8888
HOMEPIE_AUTH_SESSION_IDLE_HOURS=72
HOMEPIE_AUTH_SESSION_MAX_DAYS=30
HOMEPIE_CLIENT_DEV_PORT=5173
HOMEPIE_DOMAIN=homepie.net

# Lockkliye
LOCKKLIYE_DATA_PATH=/var/lib/lockkliye
LOCKKLIYE_RUNTIME_PATH=/var/lib/lockkliye/run
LOCKKLIYE_SECRETS_PATH=/var/lib/lockkliye/secrets
LOCKKLIYE_SOURCE_PATH=/usr/local/src/lockkliye
LOCKKLIYE_TEMP_PATH=/var/lib/lockkliye/tmp

# Teatype
TEATYPE_DATA_PATH=/var/lib/teatype
TEATYPE_PYTHON_SOURCE_PATH=/usr/local/src/teatype/python
TEATYPE_RUNTIME_PATH=/var/lib/teatype/run
TEATYPE_SECRETS_PATH=/var/lib/teatype/secrets
TEATYPE_SOURCE_PATH=/usr/local/src/teatype
TEATYPE_TEMP_PATH=/var/lib/teatype/tmp
TEATYPE_TYPESCRIPT_SOURCE_PATH=/usr/local/src/teatype/typescript

USING_WSL=false