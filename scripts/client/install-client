#########################################################
#################### START CMD PARSE ####################
#########################################################

# Check if there are any arguments
if [ "$#" -gt 0 ]; then
    echo
    echo "Hint: This script does not accept any arguments. Proceeding anyways ..."
    echo
fi

#########################################################
##################### END CMD PARSE #####################
#########################################################

#########################################################
##################### SCRIPT START ######################
#########################################################

# Installs the dependencies of the client (needed for the dev server and for builds).
set -euo pipefail

script_directory=$(dirname "$(readlink -f "$0")")
repository_root=$(cd "$script_directory/../.." && pwd)

if ! command -v pnpm >/dev/null 2>&1; then
    echo "pnpm is not installed. Install it first, e.g. with: sudo npm install -g pnpm"
    exit 1
fi

cd "$repository_root/src/client"
pnpm install --frozen-lockfile
echo "Done."
