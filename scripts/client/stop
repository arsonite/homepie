# System imports
import os

try:
    # From package imports
    from teatype.cli import BaseStopCLI
    from teatype.io import shell
except:
    print()
    print('Error: The "teatype" package is required to run this script.')
    print()
    print('Activate the teatype environment and try to run the script again:')
    print('     $ source /usr/local/src/teatype/teatype-venv/bin/activate')
    print()
    exit(1)

class Stop(BaseStopCLI):
    """
    Stops the development server of the client and starts nginx again if "start --https-port" paused it.
    Production is static files served by nginx, which keeps running for the other apps
    (stop it with "sudo systemctl stop nginx").
    """
    def modified_meta(self):
        return {
            'flags': [
                {
                    'shorthand': 'a',
                    'name': 'auth',
                    'help': 'Also stop the auth server (it keeps running after a detached start)',
                    'required': False
                }
            ]
        }
        
    def _resume_nginx(self):
        directory = os.path.dirname(os.path.realpath(__file__))
        shell(os.path.join(directory, 'dev-nginx') + ' resume')
        # Copy of the certificate that "start --https-port" made for the dev server
        shell(os.path.join(directory, 'dev-cert') + ' remove')
        
    #########
    # Hooks #
    #########
    
    def load_script(self, *args, **kwargs):
        # Runs before the early exit of the base class for the case that the dev server is already down
        if self.get_flag('auth'):
            shell(os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'server', 'stop'))
        result = super().load_script(*args, **kwargs)
        if not self._is_running:
            # The dev server is gone already (e.g. crashed), so port 443 is free for nginx
            self._resume_nginx()
        return result
    
    def execute(self):
        result = super().execute()
        # Only after the dev server released port 443
        self._resume_nginx()
        return result
        
    def pre_execute(self):
        self.set_flag('sleep', 0.25)

if __name__ == '__main__':
    Stop()
