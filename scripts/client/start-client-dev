#########################################################
#################### START CMD PARSE ####################
#########################################################

# Usage: ./start-client-dev [--no-auth]
start_auth=true

for argument in "$@"; do
    case "$argument" in
        --no-auth) start_auth=false ;;
        *)
            echo
            echo "Unknown argument '$argument'."
            echo "Usage: ./start-client-dev [--no-auth]"
            echo "    --no-auth  Do not start the auth server in development mode alongside"
            echo
            exit 1
            ;;
    esac
done

#########################################################
##################### END CMD PARSE #####################
#########################################################

#########################################################
##################### SCRIPT START ######################
#########################################################

# Runs the vite dev server on $HOMEPIE_CLIENT_DEV_PORT (5173 by default, so that it does not collide with nginx
# on 443). It forwards /api/auth to the auth server, which is started in development mode (plain-http cookies)
# unless it is already running, and stopped again together with the dev server.
set -euo pipefail

script_directory=$(dirname "$(readlink -f "$0")")
repository_root=$(cd "$script_directory/../.." && pwd)
# shellcheck source=../load-env
source "$repository_root/scripts/load-env"

if [ ! -d "$repository_root/client/node_modules" ]; then
    "$script_directory/install-client"
fi

started_auth_server=false
if [ "$start_auth" = true ]; then
    if curl -fsS "http://$HOMEPIE_AUTH_HOST:$HOMEPIE_AUTH_PORT/api/auth/health" >/dev/null 2>&1; then
        echo "The auth server is already running, using it."
        echo "Hint: if it was started without --dev, its Secure cookies are rejected on http://, so login will not work here."
    else
        "$repository_root/scripts/server/start-auth-server" --dev --detach
        started_auth_server=true
    fi
fi

stop_auth_server() {
    if [ "$started_auth_server" = true ]; then
        "$repository_root/scripts/server/stop-auth-server" || true
    fi
}
trap stop_auth_server EXIT

cd "$repository_root/client"
echo "Client dev server: http://localhost:$HOMEPIE_CLIENT_DEV_PORT (login on http, cookies are not shared with subdomains)"
VITE_PORT="$HOMEPIE_CLIENT_DEV_PORT" pnpm exec vite
