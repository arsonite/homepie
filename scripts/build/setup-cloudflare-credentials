#########################################################
#################### START CMD PARSE ####################
#########################################################

# Check if there are any arguments
if [ "$#" -gt 0 ]; then
    echo
    echo "Hint: This script does not accept any arguments. Proceeding anyways ..."
    echo
fi

#########################################################
##################### END CMD PARSE #####################
#########################################################

#########################################################
##################### SCRIPT START ######################
#########################################################

# Stores the Cloudflare API token (permission "Zone > DNS > Edit" for homepie.net) in /etc/homepie/cloudflare.ini.
# That single file is used by certbot (wildcard certificate) and by homepie-cloudflare-ddns (dynamic IP).
set -euo pipefail

credentials_file=/etc/homepie/cloudflare.ini

# Reading silently, so that the token ends up neither on screen nor in the shell history
read -r -s -p "Cloudflare API token: " token
echo

# Pasting often adds whitespace, a carriage return or quotes
token=$(printf '%s' "$token" | tr -d '[:space:]"'"'")
echo "Received $(printf '%s' "$token" | wc -c) characters (a Cloudflare API token has 40)."

if [ -z "$token" ]; then
    echo "No token entered. Exiting ..."
    exit 1
fi

# Verify the token before storing it
token_config=$(mktemp)
trap 'rm -f "$token_config"' EXIT
chmod 600 "$token_config"
printf 'header = "Authorization: Bearer %s"\n' "$token" > "$token_config"

sudo apt-get install -y curl jq > /dev/null

# User tokens are verified through /user/tokens/verify. Account-owned tokens are not accepted there, so as a fallback
# check what actually matters: that the token can see the homepie.net zone.
response=$(curl -s -m 20 -K "$token_config" https://api.cloudflare.com/client/v4/user/tokens/verify)
status=$(jq -r '.result.status // "invalid"' <<< "$response")
if [ "$status" != "active" ]; then
    zone_response=$(curl -s -m 20 -K "$token_config" "https://api.cloudflare.com/client/v4/zones?name=homepie.net")
    zone_id=$(jq -r '.result[0].id // empty' <<< "$zone_response")
    if [ -z "$zone_id" ]; then
        echo "Cloudflare does not accept this token. Cloudflare says:"
        jq -r '.errors[]?.message' <<< "$response" | sed 's/^/    /'
        echo "Make sure you pasted the token itself (shown once after 'Create token'), not the token name, the"
        echo "Zone ID or the Global API Key, and that the token has Zone > DNS > Edit for homepie.net. Exiting ..."
        exit 1
    fi
fi

sudo install -d -m 700 /etc/homepie
printf 'dns_cloudflare_api_token = %s\n' "$token" | sudo tee "$credentials_file" > /dev/null
sudo chmod 600 "$credentials_file"

echo "Token verified and stored in $credentials_file"
