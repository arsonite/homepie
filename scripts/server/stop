try:
    # From package imports
    from teatype.cli import BaseStopCLI
except:
    print()
    print('Error: The "teatype" package is required to run this script.')
    print()
    print('Activate the teatype environment and try to run the script again:')
    print('     $ source /usr/local/src/teatype/teatype-venv/bin/activate')
    print()
    exit(1)

class Stop(BaseStopCLI):
    """
    Stops the auth server, no matter if it runs in the foreground, detached, in development or in production.
    """
    #########
    # Hooks #
    #########
        
    def pre_execute(self):
        self.set_flag('sleep', 0.25)

if __name__ == '__main__':
    Stop()
