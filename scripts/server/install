#########################################################
#################### START CMD PARSE ####################
#########################################################

# Check if there are any arguments
if [ "$#" -gt 0 ]; then
    echo
    echo "Hint: This script does not accept any arguments. Proceeding anyways ..."
    echo
fi

#########################################################
##################### END CMD PARSE #####################
#########################################################

#########################################################
##################### SCRIPT START ######################
#########################################################

# Prepares everything the auth server needs: the data directories below /var/lib/homepie, the python
# environment with the dependencies, and the encryption key for the user database.
# Safe to run again, it is also what `deploy auth` uses to update the dependencies.
set -euo pipefail

script_directory=$(dirname "$(readlink -f "$0")")
repository_root=$(cd "$script_directory/../.." && pwd)
# shellcheck source=../load-env
source "$repository_root/scripts/load-env"

# Everything below, the key included, has to belong to the user the auth server runs as. sudo is only
# used for the directories, so a run with sudo would leave a root-owned key that nobody else can read.
if [ "$(id -u)" -eq 0 ]; then
    echo "Run this script as your own user, not with sudo. It asks for sudo itself where it needs it."
    exit 1
fi

echo "Creating the data directories ..."
"$repository_root/scripts/build/setup-data-dirs" homepie

echo "Preparing the python environment in $HOMEPIE_VENV_PATH ..."
# The environment usually lives below /usr/local/src, which only root can write to
if [ ! -d "$HOMEPIE_VENV_PATH" ] || [ ! -O "$HOMEPIE_VENV_PATH" ]; then
    sudo install -d -o "$(id -un)" -g "$(id -gn)" "$HOMEPIE_VENV_PATH"
    sudo chown -R "$(id -un):$(id -gn)" "$HOMEPIE_VENV_PATH"
fi
if [ ! -x "$HOMEPIE_VENV_PATH/bin/python" ]; then
    python_binary=$(command -v python3.11 || command -v python3)
    "$python_binary" -m venv "$HOMEPIE_VENV_PATH"
fi
"$HOMEPIE_VENV_PATH/bin/python" -m pip install --quiet --upgrade pip
"$HOMEPIE_VENV_PATH/bin/python" -m pip install --quiet -r "$repository_root/src/server/requirements/auth.txt"

echo "Creating the encryption key for the user database ..."
cd "$repository_root/src/server"
"$HOMEPIE_VENV_PATH/bin/python" -m homepie_auth.manage init

echo
echo "Auth server installed. Next steps:"
echo "    scripts/server/manage-users add <username>   Create your first user"
echo "    scripts/server/start --env prod --detached   Start it"
