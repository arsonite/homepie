# System imports
import os
import shlex
import subprocess
import time
import urllib.request

try:
    # From package imports
    from teatype.cli import BaseStartCLI
    from teatype.io import shell
    from teatype.logging import *
except:
    print()
    print('Error: The "teatype" package is required to run this script.')
    print()
    print('Activate the teatype environment and try to run the script again:')
    print('     $ source /usr/local/src/teatype/teatype-venv/bin/activate')
    print()
    exit(1)

class Start(BaseStartCLI):
    """
    Starts the auth server on HOMEPIE_AUTH_HOST:HOMEPIE_AUTH_PORT (127.0.0.1:8000 by default). It is never exposed
    directly, nginx (production) or the vite dev server (development) forward /api/auth to it.
    A server that is already running gets stopped first.
    """
    HEALTH_TIMEOUT_SECONDS = 10
    
    def modified_meta(self):
        return {
            'flags': [
                {
                    'shorthand': 'e',
                    'name': 'env',
                    'help': 'Environment to consider (dev: auto-reload and cookies that work on plain http, prod: Secure cookies)',
                    'options': ['dev', 'prod'],
                    'required': True
                }
            ]
        }
        
    ###########
    # Helpers #
    ###########
        
    def _load_homepie_env(self, repository_root:str):
        """
        Loads the variables of the root .env (with the defaults of .env.template) the same way the bash scripts do.
        """
        # load-env reports to stdout, so the environment is read from a separate descriptor
        command = f'repository_root={shlex.quote(repository_root)}; source "$repository_root/scripts/load-env" >&2; env -0'
        output = subprocess.run(['bash', '-c', command], capture_output=True, text=True, check=True).stdout
        for entry in output.split('\0'):
            key, _, value = entry.partition('=')
            if key.startswith('HOMEPIE_'):
                os.environ.setdefault(key, value)
                
    def _health_url(self) -> str:
        return f'http://{os.environ["HOMEPIE_AUTH_HOST"]}:{os.environ["HOMEPIE_AUTH_PORT"]}/api/auth/health'
    
    def _is_healthy(self) -> bool:
        try:
            with urllib.request.urlopen(self._health_url(), timeout=2):
                return True
        except OSError:
            return False
        
    #########
    # Hooks #
    #########
    
    def execute(self):
        super().execute()
        
        # Only a detached start returns here, a foreground server ends the script when it stops
        if not self.get_flag('detached') or self.get_flag('tail'):
            return
        
        deadline = time.monotonic() + self.HEALTH_TIMEOUT_SECONDS
        while time.monotonic() < deadline:
            if self._is_healthy():
                log(f'Auth server is running on {self._health_url().rsplit("/api", 1)[0]}')
                hint(f'Logs: {os.path.abspath(self.stdout_path)}')
                return
            time.sleep(0.5)
        
        err(f'The auth server did not answer within {self.HEALTH_TIMEOUT_SECONDS} seconds, last log lines:')
        shell(f'tail -n 20 {shlex.quote(self.stdout_path)}')
        exit(1)
            
    def pre_execute(self):
        scripts_directory = os.path.dirname(os.path.realpath(__file__))
        repository_root = os.path.abspath(os.path.join(scripts_directory, '..', '..'))
        server_root = os.path.join(repository_root, 'src', 'server')
        self._load_homepie_env(repository_root)
        
        venv_path = os.environ['HOMEPIE_VENV_PATH']
        runtime_path = os.environ['HOMEPIE_RUNTIME_PATH']
        python_binary = os.path.join(venv_path, 'bin', 'python')
        if not os.access(python_binary, os.X_OK):
            err(f'No python environment in {venv_path}. Run scripts/server/install first.', exit=True)
        if not os.path.isdir(runtime_path):
            err(f'{runtime_path} does not exist. Run scripts/server/install first.', exit=True)
        
        env = self.get_flag('env')
        self.process_name = f'homepie-auth-{env}'
        # The module is imported from the server directory, which also holds the .env of the server
        self.parent_path = server_root
        self.venv_name = venv_path
        # Under the data directory, so that no sudo is needed (the default is /var/log)
        self.LOGS_PATH = os.path.join(runtime_path, 'logs')
        
        if env == 'dev':
            log('Running in development mode')
            command_prefix = 'HOMEPIE_AUTH_DEV=1 '
            server_arguments = f'--reload --reload-dir {shlex.quote(server_root)}'
        else:
            log('Running in production mode')
            command_prefix = ''
            server_arguments = '--no-server-header'
            
        self.start_command = (f'{command_prefix}{shlex.quote(python_binary)} -m uvicorn --factory homepie_auth.app:create_app '
                              f'--host {shlex.quote(os.environ["HOMEPIE_AUTH_HOST"])} '
                              f'--port {shlex.quote(os.environ["HOMEPIE_AUTH_PORT"])} {server_arguments}')

if __name__ == '__main__':
    Start()
