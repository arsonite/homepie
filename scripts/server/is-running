try:
    # From package imports
    from teatype.cli import BaseIsRunningCLI
except:
    print()
    print('Error: The "teatype" package is required to run this script.')
    print()
    print('Activate the teatype environment and try to run the script again:')
    print('     $ source /usr/local/src/teatype/teatype-venv/bin/activate')
    print()
    exit(1)

class IsRunning(BaseIsRunningCLI):
    #########
    # Hooks #
    #########
    
    def pre_execute(self):
        # Part of the command line of the auth server (uvicorn), in development and production alike.
        # The stop script loads this file from a temporary copy, so nothing here may depend on the file location.
        self.process_names = ['homepie_auth.app:create_app']

if __name__ == '__main__':
    IsRunning()
