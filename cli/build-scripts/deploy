#########################################################
#################### START CMD PARSE ####################
#########################################################

# Usage: ./deploy [client|nginx|auth|all]
target="${1:-all}"

case "$target" in
    client | nginx | auth | all) ;;
    *)
        echo
        echo "Unknown target '$target'."
        echo "Usage: ./deploy [client|nginx|auth|all]"
        echo "    client  Build the landing page and publish it to /var/www/homepie/client"
        echo "    nginx   Install the reverse proxy configuration and reload nginx"
        echo "    auth    Update the auth server's dependencies and (re)start it in the background"
        echo "    all     All of them (default)"
        echo
        exit 1
        ;;
esac

#########################################################
##################### END CMD PARSE #####################
#########################################################

#########################################################
##################### SCRIPT START ######################
#########################################################

# Asking for sudo permissions before script executes any further and surpresses usage information
sudo 2>/dev/null

# Get the directory of the script and navigate to it.
# Necessary code-repetition to ensure being able to execute script from anywhere
script_directory=$(dirname "$(readlink -f "$0")")
cd "$script_directory" || exit 1
cd ../..
repository_root=$(pwd)

set -euo pipefail

# shellcheck source=../build-files/load-env
source "$repository_root/cli/build-files/load-env"

deploy_client() {
    echo "Building the client ..."
    cd "$repository_root/client"
    pnpm install --frozen-lockfile
    # Not `pnpm build`: that runs tsc first, and the client currently has type errors that must not block a deploy
    pnpm exec vite build

    echo "Publishing the client ..."
    sudo install -d -m 755 /var/www/homepie/client
    sudo rsync -a --delete build/ /var/www/homepie/client/
    sudo chmod -R a+rX /var/www/homepie
    cd "$repository_root"
}

deploy_nginx() {
    echo "Installing the nginx configuration ..."
    sudo install -d -m 755 /etc/nginx/snippets
    sudo install -m 644 nginx/snippets/*.conf /etc/nginx/snippets/
    sudo install -m 644 nginx/conf.d/*.conf /etc/nginx/conf.d/

    # The upstream of the auth server follows HOMEPIE_AUTH_HOST/HOMEPIE_AUTH_PORT from .env
    upstream_config=$(mktemp)
    sed "s#server [^;]*; *\# homepie-auth-upstream#server ${HOMEPIE_AUTH_HOST}:${HOMEPIE_AUTH_PORT}; \# homepie-auth-upstream#" \
        nginx/conf.d/00-homepie-auth.conf >"$upstream_config"
    sudo install -m 644 "$upstream_config" /etc/nginx/conf.d/00-homepie-auth.conf
    rm -f "$upstream_config"

    # Never reload a broken configuration, the running nginx would just keep the old one
    sudo nginx -t

    if systemctl is-active --quiet nginx; then
        sudo systemctl reload nginx
    else
        sudo systemctl start nginx
    fi
}

deploy_auth() {
    # Idempotent: creates the data directories and the venv if they are missing, installs the pinned requirements
    "$script_directory/install-auth-server"

    # Python only reads the code on start
    "$script_directory/stop-auth-server" || true
    "$script_directory/start-auth-server" --detach
}

if [ "$target" = "client" ] || [ "$target" = "all" ]; then
    deploy_client
fi

if [ "$target" = "nginx" ] || [ "$target" = "all" ]; then
    deploy_nginx
fi

if [ "$target" = "auth" ] || [ "$target" = "all" ]; then
    deploy_auth
fi

echo "Done."
