#########################################################
#################### START CMD PARSE ####################
#########################################################

# Check if there are any arguments
if [ "$#" -gt 0 ]; then
    echo
    echo "Hint: This script does not accept any arguments. Proceeding anyways ..."
    echo
fi

#########################################################
##################### END CMD PARSE #####################
#########################################################

#########################################################
##################### SCRIPT START ######################
#########################################################

# Production: builds and publishes the client, installs the nginx reverse proxy (https on 443) and (re)starts the
# auth server in the background, then checks that everything answers.
set -euo pipefail

script_directory=$(dirname "$(readlink -f "$0")")
repository_root=$(cd "$script_directory/../.." && pwd)
# shellcheck source=../build-files/load-env
source "$repository_root/cli/build-files/load-env"

"$script_directory/deploy" all

echo
echo "Checking https://$HOMEPIE_DOMAIN (resolved to this machine) ..."
failed=false
check() {
    local expected="$1" path="$2" status
    status=$(curl -sk -o /dev/null -w '%{http_code}' --resolve "$HOMEPIE_DOMAIN:443:127.0.0.1" "https://$HOMEPIE_DOMAIN$path" || true)
    if [ "$status" = "$expected" ]; then
        echo "  OK   $path -> $status"
    else
        echo "  FAIL $path -> $status (expected $expected)"
        failed=true
    fi
}
check 200 /login
check 200 /api/auth/health
check 302 /

if [ "$failed" = true ]; then
    echo "Something does not answer as expected, see README.md (Troubleshooting)."
    exit 1
fi
echo "Up and running. Add users with cli/build-scripts/manage-users add <name>."
